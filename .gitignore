# 依赖（npm install 可再生）
node_modules/

# 构建产物（taro build / tsc 可再生）
dist/
apps/miniprogram/dist/
*.tsbuildinfo

# 小程序本地凭据：appid 与代码上传私钥，绝不入库
apps/miniprogram/.auth/

# 小程序 IDE / 预览运行时（日志、进程锁、更新时间戳）
.pai/
apps/miniprogram/.pai/

# SWC 编译缓存（文件名含平台相关 hash）
apps/miniprogram/.swc/

# 日志与临时文件
*.log

# 编辑器本地配置
.vscode/

# Web e2e 运行产物（Playwright 的 trace / 截图 / 报告）
apps/web/e2e/results/
apps/web/test-results/
apps/web/playwright-report/

# 本地验收材料
/trae-tasks.md
/高三数学错题笔记.txt
/Trae_冲刺任务书.md
/SynapseV2_测试用例集.md
